      "name": "switches on decisions, decision outcomes, model output and enums",
      "mdt": [
        "module m @ 0.1",
        "use std.{human, model}",
        "use std.decision.{Choice, threshold, Confident, Uncertain}",
        "type Kind = Refund | Complaint | Question | Other",
        "type Bare = Refund | Complaint",
        "type Shape = Circle(r: Int) | Square(side: Int, label: Text)",
        "fn classify(t: Text) -> Inferred<Decision<Kind>> ! {Model} {",
        "  infer Choice<Kind> from quote(t)",
        "}",
        "fn bare(t: Text) -> Inferred<Decision<Bare>> ! {Model} {",
        "  infer Choice<Bare> from quote(t)",
        "}",
        "fn raw(t: Text) -> Text ! {Model} {",
        "  let d = classify(t)",
        "  switch d {",
        "    _ => \"x\"",
        "  }",
        "}",
        "fn partial(t: Text) -> Text ! {Model} {",
        "  let d = classify(t)",
        "  switch threshold(d, min_confidence: 0.85) {",
        "    Confident(Complaint) => \"c\"",
        "  }",
        "}",
        "fn whole(t: Text) -> Text ! {Model} {",
        "  let d = classify(t)",
        "  switch threshold(d, min_confidence: 0.85) {",
        "    Confident(k) => \"k\"",
        "    Uncertain => \"u\"",
        "  }",
        "}",
        "fn guessed(t: Text) -> Text ! {Model} {",
        "  let k = infer Kind from quote(t)",
        "  switch k {",
        "    Refund => \"r\"",
        "  }",
        "}",
        "fn plain(k: Kind) -> Text {",
        "  switch k {",
        "    Refund => \"r\"",
        "    Question => \"q\"",
        "  }",
        "}",
        "fn covered(k: Kind) -> Text {",
        "  switch k {",
        "    Refund => \"r\"",
        "    other => \"o\"",
        "  }",
        "}",
        "fn area(s: Shape) -> Text {",
        "  switch s {",
        "    Circle(r) => r",
        "    Square(side, label) => label",
        "  }",
        "}"
      ]
    },
