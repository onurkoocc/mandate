      "name": "verified, untrusted and inferred values against what is expected",
      "mdt": [
        "module m @ 0.1",
        "use std.{fs, human, model}",
        "use company.domain.{Issue, PullRequestDraft}",
        "contract A(d: PullRequestDraft) {",
        "  accept ok \"ok\" by human.approve(role: \"owner\")",
        "}",
        "contract B(d: PullRequestDraft) {",
        "  accept ok \"ok\" by human.approve(role: \"owner\")",
        "}",
        "type Holder = { d: Verified<PullRequestDraft, A> }",
        "fn read(p: Path) -> Text ! {Fs.Read} {",
        "  fs.read_text(p)",
        "}",
        "fn ship(d: Verified<PullRequestDraft, A>) -> Bool { true }",
        "fn go(d: PullRequestDraft) -> Bool {",
        "  let v = verify d against B(d)",
        "  let w = verify d against A(d)",
        "  let h = Holder { d: w }",
        "  ship(v)",
        "}",
        "fn plain(d: PullRequestDraft) -> Bool { ship(d) }",
        "fn guessed(i: Issue) -> Bool ! {Model} { ship(infer PullRequestDraft from quote(i.title)) }",
        "fn untrusted(t: Untrusted<Text>) -> Inferred<Text> { t }",
        "fn widened(n: Int) -> Dec { n }",
        "fn narrowed(n: Dec) -> Int { n }",
        "fn counted(d: PullRequestDraft) -> Bool { ship(d, d) }",
        "fn contracted(d: PullRequestDraft) -> Bool {",
        "  let v = verify d against A(d, d)",
        "  true",
        "}"
      ]
