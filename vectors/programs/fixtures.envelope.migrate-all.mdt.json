  "ir": {
    "language": "mandate/0.4",
    "module": "company.migrations",
    "version": "0.1",
    "defs": {
      "platform_lead": {
        "kind": "role",
        "description": "Platform lead"
      },
      "release_manager": {
        "kind": "role",
        "description": "Release manager"
      },
      "RepoRead": {
        "kind": "capability",
        "value": {
          "op": "call",
          "callee": {
            "op": "field",
            "of": {
              "op": "var",
              "name": "fs"
            },
            "name": "read"
          },
          "args": [
            {
              "value": {
                "op": "text",
                "value": "/work/repos"
              }
            }
          ]
        }
      },
      "SrcWrite": {
        "kind": "capability",
        "value": {
          "op": "call",
          "callee": {
            "op": "field",
            "of": {
              "op": "var",
              "name": "fs"
            },
            "name": "write"
          },
          "args": [
            {
              "value": {
                "op": "text",
                "value": "/work/repos"
              }
            }
          ]
        }
      },
      "Build": {
        "kind": "capability",
        "value": {
          "op": "call",
          "callee": {
            "op": "var",
            "name": "exec"
          },
          "args": [
            {
              "name": "commands",
              "value": {
                "op": "list",
                "items": [
                  {
                    "op": "text",
                    "value": "npm"
                  }
                ]
              }
            },
            {
              "name": "args_prefix",
              "value": {
                "op": "list",
                "items": [
                  {
                    "op": "list",
                    "items": [
                      {
                        "op": "text",
                        "value": "ci"
                      }
                    ]
                  },
                  {
                    "op": "list",
                    "items": [
                      {
                        "op": "text",
                        "value": "test"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      "ModelStd": {
        "kind": "capability",
        "value": {
          "op": "call",
          "callee": {
            "op": "field",
            "of": {
              "op": "var",
              "name": "model"
            },
            "name": "infer"
          },
          "args": [
            {
              "name": "tier",
              "value": {
                "op": "var",
                "name": "standard"
              }
            }
          ]
        }
      },
      "Merge": {
        "kind": "capability",
        "value": {
          "op": "call",
          "callee": {
            "op": "field",
            "of": {
              "op": "var",
              "name": "git"
            },
            "name": "pr"
          },
          "args": [
            {
              "value": {
                "op": "text",
                "value": "company/backend"
              }
            },
            {
              "value": {
                "op": "text",
                "value": "company/frontend"
              }
            }
          ]
        }
      },
      "Moved": {
        "kind": "contract",
        "params": [
          {
            "name": "repo",
            "type": {
              "ref": "Repo"
            }
          },
          {
            "name": "s",
            "type": {
              "ref": "Summary"
            }
          }
        ],
        "accept": {
          "moved": {
            "description": "The migrator reports what it moved",
            "by": {
              "static": {
                "op": "binary",
                "bop": ">=",
                "left": {
                  "op": "call",
                  "callee": {
                    "op": "var",
                    "name": "len"
                  },
                  "args": [
                    {
                      "value": {
                        "op": "field",
                        "of": {
                          "op": "var",
                          "name": "s"
                        },
                        "name": "migrated"
                      }
                    }
                  ]
                },
                "right": {
                  "op": "int",
                  "value": 1
                }
              }
            }
          },
          "nothing_left": {
            "description": "Nothing of the repository is left to move",
            "by": {
              "static": {
                "op": "binary",
                "bop": "==",
                "left": {
                  "op": "call",
                  "callee": {
                    "op": "var",
                    "name": "len"
                  },
                  "args": [
                    {
                      "value": {
                        "op": "field",
                        "of": {
                          "op": "var",
                          "name": "s"
                        },
                        "name": "left"
                      }
                    }
                  ]
                },
                "right": {
                  "op": "int",
                  "value": 0
                }
              }
            }
          },
          "release_approved": {
            "description": "The release manager accepts the change",
            "by": {
              "call": {
                "op": "call",
                "callee": {
                  "op": "field",
                  "of": {
                    "op": "var",
                    "name": "human"
                  },
                  "name": "approve"
                },
                "args": [
                  {
                    "name": "role",
                    "value": {
                      "op": "var",
                      "name": "release_manager"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "Migrator": {
        "kind": "agent",
        "caps": [
          {
            "op": "var",
            "name": "Build"
          },
          {
            "op": "var",
            "name": "ModelStd"
          },
          {
            "op": "var",
            "name": "RepoRead"
          },
          {
            "op": "var",
            "name": "SrcWrite"
          }
        ],
        "skills": {
          "migrate": {
            "params": [
              {
                "name": "repo",
                "type": {
                  "ref": "Repo"
                }
              }
            ],
            "returns": {
              "ref": "Inferred",
              "args": [
                {
                  "ref": "Summary"
                }
              ]
            },
            "effects": [
              {
                "effect": "Exec"
              },
              {
                "effect": "Fs.Read"
              },
              {
                "effect": "Fs.Write"
              },
              {
                "effect": "Model"
              }
            ]
          }
        },
        "role": "Moves one repository to the new logging API.",
        "budget": {
          "tokens": 400000,
          "time": {
            "ms": 1200000
          },
          "spend": {
            "micros": 500000,
            "currency": "USD"
          },
          "steps": 12
        }
      },
      "Lead": {
        "kind": "agent",
        "caps": [
          {
            "op": "var",
            "name": "ModelStd"
          },
          {
            "op": "var",
            "name": "RepoRead"
          }
        ],
        "skills": {
          "finish": {
            "params": [
              {
                "name": "repos",
                "type": {
                  "ref": "List",
                  "args": [
                    {
                      "ref": "Repo"
                    }
                  ]
                }
              },
              {
                "name": "done",
                "type": {
                  "ref": "List",
                  "args": [
                    {
                      "ref": "Outcome",
                      "args": [
                        {
                          "ref": "Inferred",
                          "args": [
                            {
                              "ref": "Summary"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "returns": {
              "ref": "Inferred",
              "args": [
                {
                  "ref": "Summary"
                }
              ]
            },
            "effects": [
              {
                "effect": "Fs.Read"
              },
              {
                "effect": "Model"
              }
            ]
          }
        },
        "role": "Plans what is left after the bulk migration and writes sub-programs for it.",
        "budget": {
          "tokens": 2000000,
          "spend": {
            "micros": 10000000,
            "currency": "USD"
          },
          "steps": 40
        }
      },
      "MigrateAll": {
        "kind": "workflow",
        "params": [
          {
            "name": "repos",
            "type": {
              "ref": "List",
              "args": [
                {
                  "ref": "Repo"
                }
              ]
            }
          }
        ],
        "returns": {
          "ref": "Inferred",
          "args": [
            {
              "ref": "Summary"
            }
          ]
        },
        "caps": [],
        "body": [
          {
            "op": "let",
            "name": "done",
            "value": {
              "op": "map",
              "bind": "repo",
              "over": {
                "op": "var",
                "name": "repos"
              },
              "body": [
                {
                  "op": "expr",
                  "value": {
                    "op": "delegate",
                    "agent": "Migrator",
                    "skill": "migrate",
                    "args": [
                      {
                        "value": {
                          "op": "var",
                          "name": "repo"
                        }
                      }
                    ]
                  }
                }
              ],
              "max": 150,
              "par": 16,
              "caps": [
                {
                  "op": "call",
                  "callee": {
                    "op": "field",
                    "of": {
                      "op": "var",
                      "name": "SrcWrite"
                    },
                    "name": "narrow"
                  },
                  "args": [
                    {
                      "value": {
                        "op": "field",
                        "of": {
                          "op": "var",
                          "name": "repo"
                        },
                        "name": "root"
                      }
                    }
                  ]
                }
              ]
            }
          },
          {
            "op": "expr",
            "value": {
              "op": "plan",
              "agent": "Lead",
              "skill": "finish",
              "args": [
                {
                  "value": {
                    "op": "var",
                    "name": "repos"
                  }
                },
                {
                  "value": {
                    "op": "var",
                    "name": "done"
                  }
                }
              ]
            }
          }
        ],
        "envelope": {
          "owner": "platform_lead",
          "caps": [
            {
              "op": "var",
              "name": "Build"
            },
            {
              "op": "var",
              "name": "Merge"
            },
            {
              "op": "var",
              "name": "ModelStd"
            },
            {
              "op": "var",
              "name": "RepoRead"
            },
            {
              "op": "var",
              "name": "SrcWrite"
            }
          ],
          "budget": {
            "tokens": 80000000,
            "time": {
              "ms": 21600000
            },
            "spend": {
              "micros": 120000000,
              "currency": "USD"
            },
            "steps": 2000,
            "agents": 200
          },
          "spawn": {
            "max_concurrent": 16,
            "max_class": "internal"
          },
          "approve": {
            "git.merge": "release_manager"
          }
        }
      }
    },
    "uses": [
      {
        "module": "company.domain",
        "names": [
          "Repo",
          "Summary"
        ]
      },
      {
        "module": "std",
        "names": [
          "exec",
          "fs",
          "git",
          "human",
          "model"
        ]
      }
    ]
  }
}
