// A sub-program the lead of migrate-all.mdt might write (spec/library.md
// "shapes"): the repositories left, migrated side by side and merged, as an
// application of FanOutMerge, a shape the envelope lists. A sub-program's
// workflow takes no parameters, so the repositories are a constant written
// at the application. It is admitted, its result naming the shape
// (FanOutMerge of std.patterns). Only its definitions are the lead's patch;
// the header is the skeleton's.

mandate @ 0.6

module company.migrations.plan_1 @ 0.1

use company.migrations

agent Merger {
  role   "Merges the summaries of the repositories migrated into one."
  caps   ModelStd
  budget { tokens: 100k, spend: 0.5 USD, steps: 4 }
  skill merge(done: List<Outcome<Inferred<Summary>>>) -> Inferred<Summary> ! {Model}
}

workflow Rest = FanOutMerge<Repo, Summary, Summary>(
    items: [Repo { name: "billing", root: "billing" }, Repo { name: "search", root: "search" }],
    work: Migrator.migrate, scope: SrcWrite, part: root,
    merge: Merger.merge, max_items: 2, concurrency: 2)
  caps   RepoRead, SrcWrite, Build, ModelStd
  budget { tokens: 1000k, time: 1h, spend: 2 USD, steps: 40, agents: 3 }
