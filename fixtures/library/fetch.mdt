// fixtures/boundary/fetch.mdt under the header of language 0.6: an agent
// that reads issues from GitHub, its capability allowing GET and nothing
// else. A 0.6 program checks as the same program of 0.5 does, so this one
// gives what fetch.mdt gives, its version aside. fetch.lock.json is the
// boundary's lock in format mandate/lock/0.6, with no library and no
// connector pinned yet. Only the Rust compiler reads either.

mandate @ 0.6

module example.fetch @ 0.1

use std.{model, net}

capability GitHubRead = net.https(hosts: ["api.github.com"], methods: [GET])
capability ModelStd   = model.infer(tier: standard, max_class: confidential)

agent Reader {
  role   "Reads one issue from GitHub and summarizes it."
  caps   GitHubRead, ModelStd
  budget { time: 10m, steps: 6 }
  skill summarize(issue: Text) -> Inferred<Text> ! {Net, Model}
}

workflow Summarize(issue: Text) -> Inferred<Text>
  caps   GitHubRead, ModelStd
  budget { time: 15m, steps: 10 }
{
  delegate Reader.summarize(issue)
}
