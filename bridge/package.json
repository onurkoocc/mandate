{
  "name": "@mandate/bridge",
  "version": "0.1.0",
  "private": true,
  "description": "The one place the runtime reaches the Mandate compiler: today a re-export of the reference compiler",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mandate/compiler": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
