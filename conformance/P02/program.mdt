// A program of 0.6 that defines a pattern and applies it (spec/library.md
// "Patterns"): BatchWithExceptions, as std.patterns gives it, with its Batch
// type, applied by a workflow to the connector, the agent, the contract and
// the roles of this program. Every check runs on the expansion, which is the
// body of conformance/H06 written out. It checks; the cases of the patterns'
// rules (P02a to P05, E1301 to E1307, and the rules of earlier slices held
// inside an expansion) are one change of it each.

mandate @ 0.6

module example.patterns @ 0.1

use std.{human, model, tool}

role accountant   "Accountant"
role finance_lead "Finance lead"

type Invoice = { invoice_no: Text, vendor_id: Text, total_cents: Int }
type Order   = { order_no: Text, vendor_id: Text, total_cents: Int }
type Match   = { invoice_no: Text, order: Order }
type DraftId = { draft_id: Text }

/// The result of a batch: each commit's outcome, what was declined, and the
/// indices of the items whose work failed.
type Batch<Out, R> = {
  posted:   List<Outcome<Receipt<R>>>,
  declined: List<Declined<Out>>,
  failed:   List<Int>
}

/// The ERP: lists the invoices and the open orders, posts draft invoices.
connector erp = mcp("https://erp.example.com/mcp")
  version "1.0"
  class   confidential
{
  tool list_invoices() -> Untrusted<List<Invoice>>
    read_only

  tool list_orders(vendor_id: Text) -> Untrusted<List<Order>>
    read_only

  tool find_draft(key: Text) -> Untrusted<Option<DraftId>>
    read_only

  tool post_draft(m: Verified<Match>, key: Text) -> Receipt<DraftId>
    critical
    idempotency key key
    retry_class reconcilable
    reconcile by find_draft
}

capability Inbox    = tool.call(erp, list_invoices)
capability ErpRead  = tool.call(erp, list_orders)
capability ErpDraft = tool.call(erp, post_draft)
capability ModelStd = model.infer(tier: standard, max_class: confidential)

/// Whether `a` is within `pct` percent of `b`.
fn near(a: Int, b: Int, pct: Int) -> Bool ! {} {
  a * 100 <= b * (100 + pct) and a * 100 >= b * (100 - pct)
}

/// A match names its invoice's vendor; its total may be off by more than 2%
/// when the accountant or the finance lead waives it.
contract Matched(inv: Invoice, m: Match) {
  accept vendor "The invoice's vendor is the order's vendor"
    by static inv.vendor_id == m.order.vendor_id
  accept totals "The total is within 2% of the order's"
    by static near(inv.total_cents, m.order.total_cents, 2)
    waive by accountant, finance_lead
}

agent Matcher {
  role   "Matches one invoice to an open order of its vendor. Writes nothing."
  caps   ErpRead, ModelStd
  budget { tokens: 60k, spend: 0.30 USD, steps: 4 }
  skill match(inv: Untrusted<Invoice>) -> Inferred<Match> ! {Tool, Model}
}

/// Works on every item of a list. What passes goes on; what does not is
/// asked about once, as one list.
pattern BatchWithExceptions<Item, Out, R>(
  source:      tool() -> Untrusted<List<Item>>,
  work:        skill(Untrusted<Item>) -> Inferred<Out>,
  accepted:    contract(Item, Out),
  reviewer:    role,
  escalate_to: role,
  commit:      effect(Verified<Out, accepted>) -> Receipt<R>,
  key:         field(Out),
  max_items:   const Int,
  concurrency: const Int,
  deadline:    const Duration
) -> Batch<Out, R>
{
  let items    = source()
  let checked  = map it in items max max_items par concurrency {
    let out = delegate work(it)
    verify out against accepted(it, out)
  }
  let reviewed = human.review(checked, role: reviewer, deadline: deadline, escalate_to: escalate_to)
  let posted   = map v in reviewed.accepted max max_items {
    effect commit(v) idempotent_by v.key
  }
  Batch { posted, declined: reviewed.declined, failed: reviewed.failed }
}

/// Matches every invoice, asks the accountant once about those that failed
/// only what may be waived, and posts each accepted match as a draft.
workflow MatchAll = BatchWithExceptions<Invoice, Match, DraftId>(
    source: erp.list_invoices, work: Matcher.match, accepted: Matched,
    reviewer: accountant, escalate_to: finance_lead,
    commit: erp.post_draft, key: invoice_no,
    max_items: 60, concurrency: 6, deadline: 1d)
  caps   Inbox, ErpRead, ErpDraft, ModelStd
  budget { spend: 20 USD, time: 2h }
