// A cycle of calls that goes through two contracts' require: f → C → g → D → f.
mandate @ 0.7

module example.recursion @ 0.1

use std.{human, model}

role accountant "Accountant"

capability ModelStd = model.infer(tier: standard, max_class: internal)

type Note = { text: Text }

agent Writer {
  role   "Writes."
  caps   ModelStd
  budget { time: 2m, steps: 2 }
  skill write(t: Text) -> Inferred<Text> ! {Model}
}

contract C(n: Note) {
  require g(n)
  accept ok "ok" by static true
}

contract D(n: Note) {
  require f(n)
  accept ok "ok" by static true
}

/// On the cycle, and asks nothing itself.
fn f(n: Note) -> Bool ! {Human} {
  let v = verify n against C(n)
  true
}

/// On the cycle too, and asks the accountant each time it runs.
fn g(n: Note) -> Bool ! {Human} {
  let a = human.ask("Again {n.text}?", role: accountant)
  let v = verify n against D(n)
  true
}

workflow V(n: Note) -> Bool
  caps   ModelStd
  budget { steps: 2 }
{
  let w = delegate Writer.write(n.text)
  f(n)
}
