    "spec/envelope.md#the-lock-members-and-roles"
  ],
  "language": "mandate/0.7",
  "input": {
    "file": "../../fixtures/attention/owner.mdt",
    "kind": "mdt"
  },
  "lock": "../../fixtures/attention/owner.lock.json",
  "patch": [
    {
      "op": "add",
      "path": "/defs/clerk",
      "value": {
        "kind": "role",
        "description": "Clerk"
      }
    },
    {
      "op": "replace",
      "path": "/defs/Describe/owner",
