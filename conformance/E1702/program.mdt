// A bounded map in a workflow with an envelope (spec/envelope.md "map"). Up to
// three items run two at a time; each writes under its own root, and its
// delegation fits in the map's budget for an item. As written the program
// checks. The cases E1702, E1702a, E1703, E1708, E1708a, E0320a and E0501b
// each change the map.

mandate @ 0.4

module example.maps @ 0.1

use std.{fs, git, human, model}

role owner_role "Owner"

type Item = { name: Text, root: Path }

capability M  = model.infer(tier: standard)
capability W  = fs.write("/work")
capability PR = git.pr("company/backend")

agent Writer {
  role   "Writes one item."
  caps   M, W
  budget { steps: 5 }
  skill w(i: Item) -> Inferred<Text> ! {Fs.Write, Model}
}

workflow Run(items: List<Item>, last: Item) -> Bool
  envelope {
    owner  owner_role
    caps   M, W
    budget { steps: 60, agents: 12 }
    spawn  { max_concurrent: 4 }
  }
{
  let done = map x in items max 3 par 2 with caps W.narrow(x.root) budget { steps: 5 } {
    delegate Writer.w(x)
  }
  let summary = delegate Writer.w(last)
  true
}
