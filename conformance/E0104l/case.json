{
  "$schema": "../case.schema.json",
  "format": "mandate/conformance-case/0.1",
  "id": "E0104l",
  "kind": "compile",
  "title": "A report title of 81 characters is refused by the schema of 0.7, which holds a title to 1 to 80 code points (a mutation: the title).",
  "spec": [
    "spec/attention.md#the-ir",
    "spec/attention.md#report"
  ],
  "language": "mandate/0.7",
  "input": {
    "file": "../../fixtures/attention/reports.mdt",
    "kind": "mdt"
  },
  "patch": [
    {
      "op": "replace",
      "path": "/defs/Greet/body/3/title",
      "value": "The greeting a model wrote for the vendor, before anyone has checked what it said"
    }
  ],
  "expect": {
    "ok": false,
    "diagnostics": [
      {
        "code": "MDT-E0104",
        "path": "/defs/Greet/body/3/title",
        "facts": {
          "keyword": "maxLength"
        }
      }
    ]
  }
}
