{
  "$schema": "../case.schema.json",
  "format": "mandate/conformance-case/0.1",
  "id": "E1602a",
  "kind": "compile",
  "title": "In a 0.6 program a type written with the path of a module that is not the standard library's is no name, even of a pub type its use lists: an unknown type at that place.",
  "spec": [
    "spec/library.md#pub-and-visibility",
    "spec/library.md#closed-imports"
  ],
  "language": "mandate/0.6",
  "input": {
    "file": "program.mdt",
    "kind": "mdt"
  },
  "modules": [
    "../E1602/types.mdt"
  ],
  "patch": [
    {
      "op": "replace",
      "path": "/defs/Read/params/0/type/ref",
      "value": "example.library.types.Invoice"
    }
  ],
  "expect": {
    "ok": false,
    "diagnostics": [
      {
        "code": "MDT-E0120",
        "path": "/defs/Read/params/0/type/ref",
        "facts": {
          "name": "example.library.types.Invoice",
          "expected": "type"
        }
      }
    ]
  }
}
