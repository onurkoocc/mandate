{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate.dev/conformance/case.schema.json",
  "title": "Mandate conformance case",
  "description": "The shape of conformance/<id>/case.json. See conformance/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "kind", "title", "spec"],
  "if": { "type": "object", "properties": { "kind": { "const": "journal" } }, "required": ["kind"] },
  "then": {
    "description": "A journal case names its export, keys and report, and nothing a compile case reads.",
    "type": "object",
    "properties": { "journal": true },
    "required": ["journal"],
    "not": {
      "anyOf": [
        { "type": "object", "properties": { "input": true }, "required": ["input"] },
        { "type": "object", "properties": { "expect": true }, "required": ["expect"] },
        { "type": "object", "properties": { "language": true }, "required": ["language"] },
        { "type": "object", "properties": { "modules": true }, "required": ["modules"] },
        { "type": "object", "properties": { "lock": true }, "required": ["lock"] },
        { "type": "object", "properties": { "patch": true }, "required": ["patch"] },
        { "type": "object", "properties": { "subprogram": true }, "required": ["subprogram"] },
        { "type": "object", "properties": { "amendment": true }, "required": ["amendment"] },
        { "type": "object", "properties": { "base": true }, "required": ["base"] }
      ]
    }
  },
  "else": {
    "type": "object",
    "properties": { "input": true, "expect": true, "journal": true },
    "required": ["expect"],
    "anyOf": [
      { "type": "object", "properties": { "input": true }, "required": ["input"] },
      { "type": "object", "properties": { "library": true }, "required": ["library"] }
    ],
    "not": { "type": "object", "properties": { "journal": true }, "required": ["journal"] }
  },
  "dependentRequired": {
    "base": ["patch"]
  },
  "dependentSchemas": {
    "subprogram": {
      "description": "A subprogram case has no top-level patch or lock.",
      "not": {
        "anyOf": [
          { "type": "object", "properties": { "patch": true }, "required": ["patch"] },
          { "type": "object", "properties": { "lock": true }, "required": ["lock"] }
        ]
      }
    },
    "amendment": {
      "description": "An amendment case has no top-level patch or lock, and no subprogram.",
      "not": {
        "anyOf": [
          { "type": "object", "properties": { "patch": true }, "required": ["patch"] },
          { "type": "object", "properties": { "lock": true }, "required": ["lock"] },
          { "type": "object", "properties": { "subprogram": true }, "required": ["subprogram"] }
        ]
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "mandate/conformance-case/0.1" },
    "id": {
      "type": "string",
      "pattern": "^([A-Z][0-9]{2}[a-z]?|E[0-9]{4}[a-z]?)$",
      "description": "Equals the name of the case directory."
    },
    "kind": { "enum": ["compile", "run", "journal"] },
    "title": { "type": "string", "minLength": 1, "description": "One sentence." },
    "spec": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "References into the spec, such as spec/ir.md#reading-ir."
    },
    "language": {
      "type": "string",
      "pattern": "^mandate/[0-9]+[.][0-9]+$",
      "description": "When given, the program the case checks declares this language."
    },
    "input": { "$ref": "#/$defs/source" },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/relativePath" },
      "description": "Module files, loaded the way --module loads them."
    },
    "lock": {
      "oneOf": [{ "$ref": "#/$defs/relativePath" }, { "type": "null" }]
    },
    "libraries": {
      "type": "array",
      "items": { "$ref": "#/$defs/relativePath" },
      "description": "Language 0.6: library directories (a mandate.library.json and the module files it lists), handed to the check as a package carries them, or to a library case as the libraries the lock pins."
    },
    "config": {
      "$ref": "#/$defs/relativePath",
      "description": "Language 0.6: a JSON file, the libraries member of the runtime's configuration ({ dir, wait_days?, revoked? })."
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "now"],
      "description": "Language 0.6: a library case. Instead of a check, mandate add, upgrade or publish as the compiler's pure functions give them; expect is compared with what they give.",
      "properties": {
        "op": { "enum": ["add", "upgrade", "publish"] },
        "name": { "type": "string", "minLength": 1, "description": "add and upgrade: the library." },
        "range": { "type": "string", "minLength": 1, "description": "add and upgrade: the range; any version when absent." },
        "versions": { "$ref": "#/$defs/relativePath", "description": "A directory of the library's version directories, <version>/ each with its manifest, modules and index.json: the candidates of add and upgrade, the versions publish finds published." },
        "only": { "type": "array", "items": { "type": "string" }, "description": "The version directories of versions to read; all when absent." },
        "pinned": { "$ref": "#/$defs/relativePath", "description": "upgrade: the directory of the version the lock pins." },
        "source": { "$ref": "#/$defs/relativePath", "description": "publish: the library to publish." },
        "now": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "description": "The time a waiting period is compared with, and publish writes." },
        "accept_governance": { "type": "boolean", "description": "upgrade: write the lock although the comparison holds a governance change." }
      }
    },
    "patch": {
      "type": "array",
      "items": { "$ref": "#/$defs/patchOp" },
      "description": "An RFC 6902 patch applied to the IR of the input before it is checked as JSON IR."
    },
    "base": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "The program hash the patch was written against. Only with patch. When it is not the hash of the input's IR, the patch is stale: MDT-E0130."
    },
    "subprogram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "room"],
      "description": "A lead's sub-program. The input is its parent; expect is compared with the sub-program's check.",
      "properties": {
        "workflow": { "type": "string", "minLength": 1, "description": "The parent's workflow whose envelope bounds the run." },
        "number": { "type": "integer", "minimum": 1, "description": "The sub-program's number; 1 when not given." },
        "defs": { "$ref": "#/$defs/source", "description": "A module whose definitions become add operations at /defs/<name>, in order." },
        "patch": {
          "type": "array",
          "items": { "$ref": "#/$defs/patchOp" },
          "description": "More operations of the lead, after those from defs."
        },
        "lead": { "enum": ["public", "internal", "confidential", "restricted"], "description": "The data class of what the lead received; public when not given." },
        "room": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left"],
          "description": "What is left of the envelope.",
          "properties": {
            "left": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 },
              "description": "What is left in each ledger dimension: tokens, steps, agents, spend:<currency> in micro-units."
            },
            "time_left_ms": { "type": "integer", "description": "Milliseconds to the run's deadline." },
            "writes": {
              "type": "array",
              "description": "Write capabilities still in flight.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ctor", "scope"],
                "properties": {
                  "ctor": { "enum": ["fs.write", "git.pr", "env.deploy", "env.migrate"] },
                  "scope": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "amendment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "patch"],
      "description": "An amendment of an envelope. The input is the program the run has; expect is compared with the amendment's check.",
      "properties": {
        "workflow": { "type": "string", "minLength": 1, "description": "The workflow whose envelope is amended." },
        "patch": {
          "type": "array",
          "items": { "$ref": "#/$defs/patchOp" },
          "description": "An RFC 6902 patch applied to the IR of that envelope; its paths start at the envelope. The patched envelope is the one the lead asks for."
        }
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["export", "keys", "report"],
      "description": "A run's journal export, the public keys its anchors are verified against, and the report a verifier gives (spec/journal.md).",
      "properties": {
        "export": { "$ref": "#/$defs/relativePath", "description": "A mandate/journal-export/0.1 document." },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relativePath" },
          "description": "PEM files of ed25519 public keys (SPKI), one or more keys each."
        },
        "report": { "$ref": "#/$defs/relativePath", "description": "The mandate/journal-verification/0.1 report, compared exactly." }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "diagnostics"],
      "properties": {
        "ok": { "type": "boolean" },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "path"],
            "properties": {
              "code": { "type": "string", "pattern": "^MDT-[EW][0-9]{4}$" },
              "path": { "type": "string", "description": "The diagnostic's at.path, an RFC 6901 pointer." },
              "facts": { "type": "object", "description": "Compared as a subset." }
            }
          }
        },
        "written": { "type": "boolean", "description": "A library case of add or upgrade (0.6): whether it gives back the lock with the new pin." },
        "hashes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "program": { "type": "string" },
            "defs": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "description": "Relative to the case directory; must stay inside the repository."
    },
    "sourceKind": { "enum": ["mdt", "json"] },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "kind"],
          "properties": {
            "file": { "$ref": "#/$defs/relativePath" },
            "kind": { "$ref": "#/$defs/sourceKind" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "kind"],
          "properties": {
            "text": { "type": "string" },
            "kind": { "$ref": "#/$defs/sourceKind" }
          }
        }
      ]
    },
    "patchOp": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path", "value"],
          "properties": {
            "op": { "enum": ["add", "replace"] },
            "path": { "type": "string" },
            "value": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path"],
          "properties": {
            "op": { "const": "remove" },
            "path": { "type": "string" }
          }
        }
      ]
    }
  }
}
