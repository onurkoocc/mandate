// A program of 0.7 whose workflow plans under an envelope with shapes
// (spec/attention.md "Sub-programs and amendments"), the parent of the
// cases of what a sub-program may show: the lead's sub-programs may apply
// Each, whose body has two stages and tells the role its application binds
// how many items it looked at. A sub-program that applies it shows that
// (A03); one that writes a stage or a report of its own is refused
// (E1705b, E1705c).

mandate @ 0.7

module example.shaped @ 0.1

use std.{fs, model}

role owner_role "Owner"

type Item = { name: Text }

capability M = model.infer(tier: standard)
capability R = fs.read("/work")

agent Worker {
  role   "Looks at one item."
  caps   M, R
  budget { tokens: 1000, spend: 1 USD, steps: 5 }
  skill look(i: Item) -> Inferred<Text> ! {Fs.Read, Model}
}

agent Lead {
  role   "Plans what is left."
  caps   M, R
  budget { tokens: 5000, spend: 2 USD, steps: 20 }
  skill finish(items: List<Item>) -> Inferred<Text> ! {Fs.Read, Model}
}

/// The two items, each looked at by `work`, `width` at a time; `reviewer`
/// is told how many there were.
pattern Each(work: skill(Item) -> Inferred<Text>, width: const Int, reviewer: role) -> List<Outcome<Inferred<Text>>> {
  stage gather "Gather the items"
  let items = [Item { name: "a" }, Item { name: "b" }]
  report to reviewer "Items gathered" { items: len(items) }

  stage look "Look at each item"
  map i in items max 2 par width {
    delegate work(i)
  }
}

workflow Run(items: List<Item>) -> Inferred<Text>
  envelope {
    owner   owner_role
    caps    M, R
    budget  { tokens: 100000, time: 1h, spend: 20 USD, steps: 200, agents: 20 }
    spawn   { max_concurrent: 4 }
    shapes  [Each]
  }
{
  plan Lead.finish(items) within envelope
}
