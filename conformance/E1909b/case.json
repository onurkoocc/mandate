{
  "$schema": "../case.schema.json",
  "format": "mandate/conformance-case/0.1",
  "id": "E1909b",
  "kind": "compile",
  "title": "With a lock, a report to a role shows data above that role's class: each confidential field is refused at its value (a mutation: the report addressed to the observer).",
  "spec": [
    "spec/attention.md#lock-07",
    "spec/attention.md#static-rules"
  ],
  "language": "mandate/0.7",
  "input": {
    "file": "../A05/program.mdt",
    "kind": "mdt"
  },
  "lock": "../A05/mandate.lock.json",
  "patch": [
    {
      "op": "replace",
      "path": "/defs/Settle/body/4/role",
      "value": "observer"
    }
  ],
  "expect": {
    "ok": false,
    "diagnostics": [
      {
        "code": "MDT-E1909",
        "path": "/defs/Settle/body/4/fields/0/value",
        "facts": {
          "workflow": "Settle",
          "role": "observer",
          "class": "internal",
          "shown": "confidential",
          "site": "report",
          "field": "accepted"
        }
      },
      {
        "code": "MDT-E1909",
        "path": "/defs/Settle/body/4/fields/1/value",
        "facts": {
          "workflow": "Settle",
          "role": "observer",
          "class": "internal",
          "shown": "confidential",
          "site": "report",
          "field": "key"
        }
      }
    ]
  }
}
