{
  "$schema": "../case.schema.json",
  "format": "mandate/conformance-case/0.1",
  "id": "E1903",
  "kind": "compile",
  "title": "A report title with a control character is refused: a person reads the title on an approval card (a mutation: the title of Greet's first report).",
  "spec": [
    "spec/attention.md#report",
    "spec/attention.md#titles",
    "spec/attention.md#static-rules"
  ],
  "language": "mandate/0.7",
  "input": {
    "file": "../../fixtures/attention/reports.mdt",
    "kind": "mdt"
  },
  "patch": [
    {
      "op": "replace",
      "path": "/defs/Greet/body/3/title",
      "value": "Greeting\u0007 drafted"
    }
  ],
  "expect": {
    "ok": false,
    "diagnostics": [
      {
        "code": "MDT-E1903",
        "path": "/defs/Greet/body/3/title",
        "facts": {
          "role": "accountant",
          "problem": "title",
          "rule": "control",
          "char": "U+0007"
        }
      }
    ]
  }
