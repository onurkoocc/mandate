mandate @ 0.6

module example.fleet.plan_1 @ 0.1

use example.fleet

workflow Move = FanOutMerge<Repo, Summary, Summary>(
    items: [Repo { name: "api", root: "api" }, Repo { name: "web", root: "web" }],
    work: Migrator.migrate, scope: SrcWrite, part: root,
    merge: Reporter.sum, max_items: 2, concurrency: 2)
  caps   RepoRead, SrcWrite, ModelStd
  budget { tokens: 200k, time: 1h, spend: 5 USD, steps: 100, agents: 10 }
