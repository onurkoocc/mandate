{
  "$schema": "../case.schema.json",
  "format": "mandate/conformance-case/0.1",
  "id": "E1504a",
  "kind": "compile",
  "title": "A criterion whose method includes human.approve, joined by and to a static check, cannot be waived either (a mutation: a contract added).",
  "spec": [
    "spec/library.md#waive-by",
    "spec/library.md#diagnostics-and-conformance-cases"
  ],
  "language": "mandate/0.6",
  "input": {
    "file": "../H06/program.mdt",
    "kind": "mdt"
  },
  "patch": [
    {
      "op": "add",
      "path": "/defs/Signed",
      "value": {
        "kind": "contract",
        "params": [
          {
            "name": "m",
            "type": {
              "ref": "Match"
            }
          }
        ],
        "accept": {
          "signed": {
            "description": "The controller signed it",
            "by": {
              "all": [
                {
                  "static": {
                    "op": "bool",
                    "value": true
                  }
                },
                {
                  "call": {
                    "op": "call",
                    "callee": {
                      "op": "field",
                      "of": {
                        "op": "var",
                        "name": "human"
                      },
                      "name": "approve"
                    },
                    "args": [
                      {
                        "name": "role",
                        "value": {
                          "op": "var",
                          "name": "controller"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            "waive": [
              "accountant"
            ]
          }
        }
      }
    }
  ],
  "expect": {
    "ok": false,
    "diagnostics": [
      {
        "code": "MDT-W0601",
        "path": "/defs/Matched/accept/totals/by/static"
      },
      {
        "code": "MDT-W0601",
        "path": "/defs/Matched/accept/vendor/by/static"
      },
      {
        "code": "MDT-E1504",
        "path": "/defs/Signed/accept/signed/waive",
        "facts": {
          "contract": "Signed",
          "criterion": "signed"
        }
      }
    ]
  }
