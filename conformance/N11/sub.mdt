// The definitions of a lead's sub-program of N11/parent.mdt (N11): a
// workflow written out, which a sub-program under an envelope with shapes
// may not be. Only its definitions are read.

mandate @ 0.6

module example.shaped.plan_1 @ 0.1

use example.shaped

workflow Look() -> Inferred<Text>
  caps   M, R
  budget { tokens: 2000, time: 10m, spend: 2 USD, steps: 10, agents: 2 }
{
  delegate Worker.look(Item { name: "a" })
}
