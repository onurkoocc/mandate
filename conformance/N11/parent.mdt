// A program of 0.6 whose workflow plans under an envelope with shapes
// (spec/library.md "shapes"), the parent of the cases of shapes: the lead's
// sub-programs may apply Each, which the program defines, or FanOutMerge of
// std.patterns, and nothing else. Spare is a pattern of the program the
// envelope does not list; Batch is a type of std.patterns, which no shape
// may name (E1711a).

mandate @ 0.6

module example.shaped @ 0.1

use std.{fs, model}
use std.patterns.{Batch, FanOutMerge}

role owner_role "Owner"

type Item = { name: Text }

capability M = model.infer(tier: standard)
capability R = fs.read("/work")

agent Worker {
  role   "Looks at one item."
  caps   M, R
  budget { tokens: 1000, spend: 1 USD, steps: 5 }
  skill look(i: Item) -> Inferred<Text> ! {Fs.Read, Model}
}

agent Lead {
  role   "Plans what is left."
  caps   M, R
  budget { tokens: 5000, spend: 2 USD, steps: 20 }
  skill finish(items: List<Item>) -> Inferred<Text> ! {Fs.Read, Model}
}

/// The two items, each looked at by `work`, `width` at a time.
pattern Each(work: skill(Item) -> Inferred<Text>, width: const Int) -> List<Outcome<Inferred<Text>>> {
  let items = [Item { name: "a" }, Item { name: "b" }]
  map i in items max 2 par width {
    delegate work(i)
  }
}

/// The same two items, one at a time: a pattern the envelope does not list.
pattern Spare(work: skill(Item) -> Inferred<Text>) -> List<Outcome<Inferred<Text>>> {
  let items = [Item { name: "a" }, Item { name: "b" }]
  map i in items max 2 {
    delegate work(i)
  }
}

workflow Run(items: List<Item>) -> Inferred<Text>
  envelope {
    owner   owner_role
    caps    M, R
    budget  { tokens: 100000, time: 1h, spend: 20 USD, steps: 200, agents: 20 }
    spawn   { max_concurrent: 4 }
    shapes  [FanOutMerge, Each]
  }
{
  plan Lead.finish(items) within envelope
}
