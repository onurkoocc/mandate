// A change landed with what peek gives of a name nothing defines: the
// runtime would stop at the name, and the checker cannot tell the value.

mandate @ 0.6

module example.small @ 0.1

use std.{git, human}

role reviewer "Reviewer"

type Change = { branch: Text, risk: Int }

capability PR = git.pr("example/app")

/// A change names the branch it merges.
contract Named(c: Change) {
  accept named "The change names its branch"
    by static len(c.branch) >= 1
}

/// A change is small.
contract Small(c: Change) {
  accept small "The change is small"
    by static c.risk < 3
}

/// Opens or lands a change.
workflow Land(change: Change) -> Bool
  caps   PR
  budget { time: 1h }
{
  let approved = human.approve(role: reviewer)
  effect git.merge(peek(nowhere)) idempotent_by change.branch
  true
}
