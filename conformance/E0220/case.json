  "input": { "file": "program.mdt", "kind": "mdt" },
  "patch": [
    {
      "op": "replace",
      "path": "/defs/W/body/1",
      "value": { "op": "expr", "value": { "op": "delegate", "agent": "A", "skill": "s", "args": [{ "value": { "op": "var", "name": "d" } }] } }
    }
  ],
  "expect": {
    "ok": false,
    "diagnostics": [{ "code": "MDT-E0220", "path": "/defs/W/body/1/value", "facts": { "data_class": "confidential", "allowed": "internal", "by": "envelope" } }]
