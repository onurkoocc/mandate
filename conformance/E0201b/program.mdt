// A function that declares a verified change and ends with an if whose else
// gives the change as it was given.

mandate @ 0.6

module example.small @ 0.1

use std.{git}

type Change = { branch: Text, risk: Int }

capability PR = git.pr("example/app")

/// A change names the branch it merges.
contract Named(c: Change) {
  accept named "The change names its branch"
    by static len(c.branch) >= 1
}

/// A change is small.
contract Small(c: Change) {
  accept small "The change is small"
    by static c.risk < 3
}

/// The change verified, or as it was given.
fn pick(c: Verified<Change>, raw: Change, big: Bool) -> Verified<Change> ! {} {
  if big {
    c
  } else {
    raw
  }
}

/// Opens or lands a change.
workflow Land(change: Change) -> Bool
  caps   PR
  budget { time: 1h }
{
  let named = verify change against Named(change)
  effect git.open_pr(pick(named, change, true)) idempotent_by change.branch
  true
}
