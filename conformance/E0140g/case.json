  "id": "E0140g",
  "kind": "compile",
  "title": "A lock of 0.7 that gives a class to a role its roles do not name is refused at that entry: nobody holds the role (a mutation: auditor added to role_classes).",
  "spec": [
    "spec/attention.md#lock-07",
    "spec/lock.md"
  ],
  "language": "mandate/0.7",
  "input": {
    "file": "../../fixtures/attention/owner.mdt",
    "kind": "mdt"
  },
  "lock": "mandate.lock.json",
  "expect": {
    "ok": false,
    "diagnostics": [
      {
        "code": "MDT-E0140",
        "path": "/role_classes/auditor",
