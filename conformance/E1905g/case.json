{
  "$schema": "../case.schema.json",
  "format": "mandate/conformance-case/0.1",
  "id": "E1905g",
  "kind": "compile",
  "title": "A report directly before an on error is refused: the handler would handle the statement before the report, which changes no value of the run (a mutation: a handler added after Greet's first report).",
  "spec": [
    "spec/attention.md#report",
    "spec/attention.md#static-rules"
  ],
  "language": "mandate/0.7",
  "input": {
    "file": "../../fixtures/attention/reports.mdt",
    "kind": "mdt"
  },
  "patch": [
    {
      "op": "replace",
      "path": "/defs/Greet/body/3/title",
      "value": "Moved"
    },
    {
      "op": "add",
      "path": "/defs/Greet/body/4",
      "value": {
        "op": "on_error",
        "pattern": {
          "p": "wild"
        },
        "then": {
          "op": "var",
          "name": "line"
        }
      }
    }
  ],
  "expect": {
    "ok": false,
    "diagnostics": [
      {
        "code": "MDT-E1905",
        "path": "/defs/Greet/body/3",
        "facts": {
          "role": "accountant",
          "title": "Moved",
          "place": "before_on_error"
        }
      }
    ]
  }
}
