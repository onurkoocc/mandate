  "patch": [
    { "op": "remove", "path": "/defs/Run/body/0/value/max" },
    { "op": "remove", "path": "/defs/Run/body/0/value/budget" },
    { "op": "replace", "path": "/defs/Run/body/0/value/body/0", "value": { "op": "expr", "value": { "op": "field", "of": { "op": "var", "name": "x" }, "name": "name" } } }
