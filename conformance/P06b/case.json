{
  "$schema": "../case.schema.json",
  "format": "mandate/conformance-case/0.1",
  "id": "P06b",
  "kind": "compile",
  "title": "A lead's sub-program whose workflow applies a pattern with a run parameter takes a parameter, which a sub-program's workflow cannot: E1705, at the application.",
  "spec": ["spec/library.md#expansion", "spec/envelope.md#the-sub-program", "spec/library.md#diagnostics-and-conformance-cases"],
  "language": "mandate/0.6",
  "input": { "file": "../P06/parent.mdt", "kind": "mdt" },
  "subprogram": {
    "workflow": "Run",
    "defs": { "file": "../P06/sub.mdt", "kind": "mdt" },
    "patch": [
      {
        "op": "replace",
        "path": "/defs/Look/apply",
        "value": {
          "pattern": "Over",
          "args": [{ "name": "work", "value": { "op": "field", "of": { "op": "var", "name": "Worker" }, "name": "look" } }]
        }
      }
    ],
    "room": { "left": { "tokens": 50000, "steps": 100, "agents": 10, "spend:USD": 10000000 }, "time_left_ms": 1800000 }
  },
  "expect": {
    "ok": false,
    "diagnostics": [
      { "code": "MDT-E1705", "path": "/defs/Look/apply", "facts": { "def": "Look", "kind": "parameters", "params": 1 } }
    ]
  }
}
