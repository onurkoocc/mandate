// conformance/L07 with acme.connectors as a library (L07a): the program
// holds a read tool of its ERP connector and imports none of the types of
// that tool's signature, which it need not, since a library's module is
// linked through what its library reaches. Its lead's sub-program calls the
// tool, and sees what its parent sees: the type the connector means among it.

mandate @ 0.6

module example.orders @ 0.1

use std.{model, tool}
use acme.connectors.{erp}

role owner_role "Owner"

capability ErpRead  = tool.call(erp, list_open_orders)
capability ModelStd = model.infer(tier: standard, max_class: confidential)

agent Lead {
  role   "Plans the reading of the open orders."
  caps   ModelStd
  budget { tokens: 5000, spend: 2 USD, steps: 20 }
  skill finish(vendor: Text) -> Inferred<Text> ! {Model}
}

workflow Run(vendor: Text) -> Inferred<Text>
  envelope {
    owner   owner_role
    caps    ErpRead, ModelStd
    budget  { tokens: 100000, time: 1h, spend: 20 USD, steps: 200, agents: 20 }
    spawn   { max_concurrent: 4, max_class: confidential }
  }
{
  plan Lead.finish(vendor) within envelope
}
