{
  "$schema": "../case.schema.json",
  "format": "mandate/conformance-case/0.1",
  "id": "E1407b",
  "kind": "compile",
  "title": "A lock entry whose url is not the connector's declared URL is refused: the credential goes to the URL the lock names.",
