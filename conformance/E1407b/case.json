    "spec/library.md#the-lock-binding-and-schema-digests",
    "spec/lock.md#libraries-and-connectors-06"
  ],
  "language": "mandate/0.6",
  "input": {
    "file": "../T01/program.mdt",
    "kind": "mdt"
  },
  "lock": "mandate.lock.json",
  "expect": {
    "ok": false,
    "diagnostics": [
      {
        "code": "MDT-E1407",
        "path": "/connectors/example.erp.erp/url",
        "facts": {
          "connector": "example.erp.erp",
          "problem": "url",
          "url": "https://erp.example.org/mcp",
