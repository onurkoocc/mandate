// acme.owners 1.1.0, a library of 0.7 (L11): 1.0.0 with the clerk as the
// workflow's owner, a role it already asks: its authority signature does
// not widen, and who approves it changed, so a minor version is refused.

mandate @ 0.7

module acme.owners @ 1.0

use std.{human, model}

pub role accountant "Accountant"
pub role clerk      "Clerk"

pub capability M = model.infer(tier: standard)

/// Asks the clerk whether a note is right.
pub workflow Confirm(note: Text) -> Untrusted<Text>
  owner  clerk
  caps   M
  budget { time: 10m }
{
  human.ask("Is {note} right?", role: clerk)
}
