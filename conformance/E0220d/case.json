              }
            },
            {
              "name": "max_class",
              "value": {
                "op": "var",
                "name": "public"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/defs/Draft/body/1/value/caps",
      "value": [
        {
          "op": "var",
          "name": "ModelPub"
        }
      ]
    }
  ],
  "expect": {
    "ok": false,
    "diagnostics": [
      {
        "code": "MDT-E0220",
