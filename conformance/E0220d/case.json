{
  "$schema": "../case.schema.json",
  "format": "mandate/conformance-case/0.1",
  "id": "E0220d",
  "kind": "compile",
  "title": "A delegation whose with caps narrows the agent's model below the class of the connector whose tools it is granted is refused at the delegation.",
  "spec": [
    "spec/library.md#declaration",
    "spec/library.md#what-reaches-a-model"
  ],
  "language": "mandate/0.6",
  "input": {
    "file": "../T01/program.mdt",
    "kind": "mdt"
  },
  "patch": [
