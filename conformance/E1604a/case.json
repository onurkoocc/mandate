  "id": "E1604a",
  "kind": "compile",
  "title": "A 0.6 program may import std.patterns, which is built into the compiler, with no module given; a name its list brings that the library does not define is refused at the list.",
  "spec": [
    "spec/library.md#closed-imports",
    "spec/library.md#stdpatterns"
  ],
  "language": "mandate/0.6",
  "input": {
    "file": "../E1602/program.mdt",
    "kind": "mdt"
  },
  "modules": [
    "../E1602/types.mdt"
  ],
  "patch": [
    {
      "op": "add",
      "path": "/uses/-",
      "value": {
        "module": "std.patterns",
        "names": [
          "Nothing"
        ]
      }
    }
  ],
  "expect": {
    "ok": false,
    "diagnostics": [
      {
        "code": "MDT-E0120",
        "path": "/uses/2/names",
        "facts": {
          "name": "Nothing",
          "module": "std.patterns",
          "expected": "definition"
        }
      }
    ]
  }
