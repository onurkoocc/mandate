// conformance/E0301a/program.mdt as a program of 0.5: only the constructor of
// the first `requires caps` is compared, the directory's, so it checks, as it
// always did.

mandate @ 0.5

module example.publish @ 0.1

use std.{fs, git}

capability Notes = fs.write("/srv/notes")

effect publish(note: Text) -> Text
  requires caps fs.write("/srv/notes")
  requires caps git.pr("acme/app")
  critical
  idempotency required

workflow Publish(note: Text) -> Text
  caps   Notes
  budget { time: 1m }
{
  effect publish(note) idempotent_by note
}
