{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate.dev/spec/ir/0.1/schema.json",
  "title": "Mandate canonical IR 0.1",
  "description": "Closed schema for the canonical IR (Doc 4 §3.2-§3.5). Unknown fields are errors. Schema validity does not replace type, effect, capability or budget checking.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "module",
    "version",
    "defs"
  ],
  "properties": {
    "language": {
      "enum": [
        "mandate/0.1",
        "mandate/0.2",
        "mandate/0.3"
      ]
    },
    "module": {
      "$ref": "#/$defs/QName"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)*([-+][0-9A-Za-z.]+)?$"
    },
    "uses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module": {
            "$ref": "#/$defs/QName"
          },
          "names": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Name"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false,
        "required": [
          "module"
        ]
      }
    },
    "defs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Def"
      },
      "propertyNames": {
        "$ref": "#/$defs/QName"
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Test"
      }
    }
  },
  "$defs": {
    "Name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "QName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "Param": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Name"
        },
        "type": {
          "$ref": "#/$defs/TypeExpr"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ]
    },
    "Params": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Param"
      }
    },
    "Money": {
      "type": "object",
      "properties": {
        "micros": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "micros",
        "currency"
      ]
    },
    "Budget": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "spend": {
          "$ref": "#/$defs/Money"
        },
        "time": {
          "type": "object",
          "properties": {
            "ms": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "ms"
          ]
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Arg": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Name"
        },
        "value": {
          "$ref": "#/$defs/Expr"
        }
      },
      "additionalProperties": false,
      "required": [
        "value"
      ]
    },
    "Args": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Arg"
      }
    },
    "CallSpec": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Name"
        },
        "args": {
          "$ref": "#/$defs/Args"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "EffectRef": {
      "type": "object",
      "properties": {
        "effect": {
          "$ref": "#/$defs/QName"
        },
        "args": {
          "$ref": "#/$defs/Args"
        }
      },
      "additionalProperties": false,
      "required": [
        "effect"
      ]
    },
    "Effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EffectRef"
      }
    },
    "Variant": {
      "type": "object",
      "properties": {
        "tag": {
          "$ref": "#/$defs/Name"
        },
        "fields": {
          "$ref": "#/$defs/Params"
        }
      },
      "additionalProperties": false,
      "required": [
        "tag"
      ]
    },
    "TypeExpr": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ref": {
              "$ref": "#/$defs/QName"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TypeExpr"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "ref"
          ]
        },
        {
          "type": "object",
          "properties": {
            "record": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/TypeExpr"
              },
              "propertyNames": {
                "$ref": "#/$defs/Name"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "record"
          ]
        },
        {
          "type": "object",
          "properties": {
            "enum": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Name"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "required": [
            "enum"
          ]
        },
        {
          "type": "object",
          "properties": {
            "union": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Variant"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "union"
          ]
        },
        {
          "type": "object",
          "properties": {
            "refine": {
              "$ref": "#/$defs/TypeExpr"
            },
            "where": {
              "$ref": "#/$defs/Expr"
            }
          },
          "additionalProperties": false,
          "required": [
            "refine",
            "where"
          ]
        }
      ]
    },
    "TemplatePart": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "expr": {
              "$ref": "#/$defs/Expr"
            }
          },
          "additionalProperties": false,
          "required": [
            "expr"
          ]
        }
      ]
    },
    "Pattern": {
      "type": "object",
      "discriminator": {
        "propertyName": "p"
      },
      "required": [
        "p"
      ],
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "p": {
              "const": "wild"
            }
          },
          "additionalProperties": false,
          "required": [
            "p"
          ]
        },
        {
          "type": "object",
          "properties": {
            "p": {
              "const": "bind"
            },
            "name": {
              "$ref": "#/$defs/Name"
            }
          },
          "additionalProperties": false,
          "required": [
            "p",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "p": {
              "const": "tag"
            },
            "tag": {
              "$ref": "#/$defs/Name"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Pattern"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "p",
            "tag"
          ]
        }
      ]
    },
    "Expr": {
      "type": "object",
      "discriminator": {
        "propertyName": "op"
      },
      "required": [
        "op"
      ],
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "int"
            },
            "value": {
              "type": "integer"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "dec"
            },
            "value": {
              "type": "string",
              "pattern": "^-?[0-9]+\\.[0-9]+$"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "value"
          ]
        },
        {
