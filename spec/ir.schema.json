            "op": {
              "const": "money"
            },
            "micros": {
              "type": "integer"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "micros",
            "currency"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "duration"
            },
            "ms": {
              "type": "integer",
              "minimum": 0
