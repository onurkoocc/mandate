            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "field"
            },
            "of": {
              "$ref": "#/$defs/Expr"
            },
            "name": {
              "$ref": "#/$defs/Name"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "of",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "call"
            },
            "callee": {
              "$ref": "#/$defs/Expr"
            },
            "args": {
              "$ref": "#/$defs/Args"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "callee",
            "args"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "unary"
            },
            "uop": {
              "enum": [
                "not",
                "neg"
              ]
            },
            "of": {
              "$ref": "#/$defs/Expr"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "uop",
            "of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "binary"
            },
            "bop": {
              "enum": [
                "and",
                "or",
                "==",
                "!=",
                "<",
                "<=",
                ">",
                ">=",
                "in",
                "subseteq",
                "+",
                "-",
                "*",
                "/"
              ]
            },
            "left": {
              "$ref": "#/$defs/Expr"
            },
            "right": {
              "$ref": "#/$defs/Expr"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
