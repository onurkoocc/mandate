          },
          "additionalProperties": false,
          "required": [
            "op",
            "ms"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expr"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "items"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "set"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expr"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "items"
          ]
        },
        {
          "type": "object",
          "properties": {
