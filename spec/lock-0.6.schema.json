{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate.dev/spec/lock-0.6.schema.json",
  "title": "Mandate lock file (mandate/lock/0.6)",
  "description": "A lock of format mandate/lock/0.6: every field of a 0.5 lock, and the libraries a 0.6 program imports (each library's version, digest and modules by program hash) and the connectors it can call (each connector's credential, by name, and the digest of each tool's schema). A lock of 0.2 to 0.5 is closed by spec/lock.schema.json instead; each lock is read by the schema of its own format. Part of the package hash. See spec/lock.md and spec/library.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lock", "modules"],
  "$defs": {
    "Version": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,8})(\\.(0|[1-9][0-9]{0,8})){0,2}$" },
    "Level": { "enum": ["process", "user_kernel", "microvm", "dedicated_host"] },
    "DataClass": { "enum": ["public", "internal", "confidential", "restricted"] },
    "Digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "QName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$" },
    "LibraryName": { "type": "string", "maxLength": 128, "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*$", "description": "A library's name and the name of each of its modules: dot-separated lower-case names (spec/library.md \"The manifest\"), as crates/mandate-lib reads them." },
    "LibraryVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$" }
  },
  "properties": {
    "lock": { "enum": ["mandate/lock/0.6"] },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "node": { "$ref": "#/$defs/Version" },
        "bwrap": { "$ref": "#/$defs/Version" }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "floor": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/DataClass" },
          "additionalProperties": { "$ref": "#/$defs/Level" }
        },
        "untrusted_network": { "$ref": "#/$defs/Level" },
        "co_tenancy": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/DataClass" },
          "additionalProperties": { "enum": ["allowed", "forbidden"] }
        }
      }
    },
    "egress": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": { "type": "string", "minLength": 1, "maxLength": 253 },
        "additionalProperties": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" }
      }
    },
    "libraries": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/LibraryName" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "digest", "modules"],
        "properties": {
          "version": { "$ref": "#/$defs/LibraryVersion" },
          "digest": { "$ref": "#/$defs/Digest" },
          "modules": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "$ref": "#/$defs/LibraryName" },
            "additionalProperties": { "$ref": "#/$defs/Digest" }
          }
        }
      }
    },
    "connectors": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/QName" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credential", "tools", "url"],
        "properties": {
          "credential": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
          "url": { "type": "string", "minLength": 1 },
          "header": { "type": "string", "minLength": 1 },
          "template": { "type": "string", "minLength": 1 },
          "tools": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "additionalProperties": { "$ref": "#/$defs/Digest" }
          }
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "models": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "model", "effort", "max_input_tokens", "max_output_tokens"],
        "properties": {
          "provider": { "const": "anthropic" },
          "model": { "type": "string", "minLength": 1 },
          "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
          "max_input_tokens": { "type": "integer", "minimum": 1 },
          "max_output_tokens": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "tariffs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["currency", "as_of", "micros_per_mtok"],
        "properties": {
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "micros_per_mtok": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "output", "cache_read", "cache_write"],
            "properties": {
              "input": { "type": "integer", "minimum": 0 },
              "output": { "type": "integer", "minimum": 0 },
              "cache_read": { "type": "integer", "minimum": 0 },
              "cache_write": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "members": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keys"],
        "properties": {
          "keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "managed-agents": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "beta", "tools", "environment", "session_fee", "harness_tokens", "agents", "profile"],
          "properties": {
            "format": { "const": "mandate/binding/managed-agents/0.1" },
            "beta": { "type": "string", "minLength": 1 },
            "tools": { "const": "bridge" },
            "environment": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "config"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "config": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              }
            },
            "session_fee": {
              "type": "object",
              "additionalProperties": false,
              "required": ["currency", "micros_per_hour"],
              "properties": {
                "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
                "micros_per_hour": { "type": "integer", "minimum": 0 }
              }
            },
            "harness_tokens": { "type": "integer", "minimum": 0 },
            "agents": {
              "type": "object",
              "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "version", "tier", "model", "effort", "max_output_tokens", "config"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "version": { "type": "integer", "minimum": 1 },
                  "tier": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                  "model": { "type": "string", "minLength": 1 },
                  "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
                  "max_output_tokens": { "type": "integer", "minimum": 1 },
                  "config": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                }
              }
            },
            "profile": { "type": "object", "additionalProperties": { "enum": ["full", "partial", "none"] } }
          }
        }
      }
    }
  }
}
