{
  "database": "pglite:.mandate/db",
  "artifacts": ".mandate/artifacts",
  "evidence": { "key": ".mandate/evidence.key" },
  "model": { "provider": "anthropic" },
  "sandbox": { "host": "mxc", "baseline": ["/usr/local"] },
  "github": { "repo": "onurkoocc/mandate-fixbug-target", "base": "main", "workdir": "/work/repo" },
  "verifier": {
    "workdir": "/work/repo",
    "base": "seed",
    "suites": { "unit": "test/**/*.test.ts", "integration": "acceptance/**/*.test.ts" },
    "command": ["node", "--test"],
    "timeoutMs": 120000
  }
}
